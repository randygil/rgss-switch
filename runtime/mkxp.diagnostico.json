//==============================================================================
// Pokemon Anil 4.0 — configuracion de mkxp-z para Nintendo Switch (Horizon OS)
//
// Generado por el hito H5 del port. Las diferencias frente al mkxp.json de
// escritorio estan comentadas una por una. Es JSON con comentarios //, tal
// como el original.
//==============================================================================
{
    "windowTitle": "Pokémon Añil 4.0",

    // Resolucion interna del juego. NO se toca: Essentials dibuja todas sus
    // escenas contra 512x384 y cambiarlo descoloca los menus.
    "defScreenW": 512,
    "defScreenH": 384,

    // La Switch entrega 1280x720 tanto en dock como en portatil (el modo dock
    // a 1080p lo escala el sistema). 720 / 384 = 1.875 exacto, y
    // 512 * 1.875 = 960. El resultado es una imagen de 960x720 con bandas
    // negras laterales, sin recortar ni deformar nada.
    //
    // Por eso el escalado ENTERO va desactivado: a 720p solo cabria 1x
    // (512x384 en medio de la pantalla, diminuto). El escalado suave a 1.875x
    // aprovecha el panel completo.
    "fullscreen": true,
    "winResizable": false,
    "fixedAspectRatio": true,
    "integerScalingActive": false,
    "smoothScaling": true,

    // Lanczos3 da mejor filtrado que el bilineal, pero es un shader caro para
    // el Tegra X1 a 307 MHz de GPU en portatil. Candidato de H6, no de salida.
    "lanczos3Scaling": false,

    // Se mantiene del original: el juego lo traia activado y los drivers de
    // Tegra bajo Mesa/nouveau son justo el caso que este apano cubre
    // (texturas que no se sincronizan y tilesets que no aparecen).
    "subImageFix": true,

    "vsync": true,
    "syncToRefreshrate": true,

    // Indexa las rutas en minusculas. En la Switch NO es opcional: los assets
    // van sueltos sobre FAT32/exFAT y son 17.815 PNG mas 2.187 WAV. Sin la
    // cache, cada Bitmap.new dispara una apertura de FatFS y los mapas tardan
    // segundos en cargar. (En mkxp-z v2.4.2 ya viene true por defecto; se deja
    // explicito porque es la decision de rendimiento mas importante del port.)
    "pathCache": true,

    // Sin teclado no hay forma de invocar estos dos. settingsmenu.cpp ademas
    // asume entrada de teclado (ver H4).
    "enableReset": false,
    "enableSettings": false,

    // Ruby 3.1.7 aun tiene Dir.exists?/File.exists?, asi que preload.rb no es
    // imprescindible, pero silencia los avisos de obsolescencia. OJO:
    // preloadScript viene VACIO por defecto en mkxp-z, el fichero NO se carga
    // solo por estar en la carpeta.
    // lib/nx-trazas.rb son sondas de Ruby (hilos, fotogramas, fps). Utiles para
    // depurar, pero cuestan una llamada de metodo por fotograma: fuera en produccion.
    // lib/nx-guardado.rb comprueba el camino de guardado sobre la SD. Se anade a
    // esta lista solo cuando se quiere medir, y se quita despues.
    "preloadScript": ["lib/nx-compat.rb", "lib/nx-sonido.rb", "lib/nx-teclado.rb", "lib/nx-rutas.rb", "lib/nx-gc.rb", "lib/nx-metodos.rb", "lib/nx-tira.rb", "lib/nx-centro.rb", "lib/nx-bolas.rb", "preload.rb"],

    // Carpeta lib/ = subconjunto de la biblioteca estandar de Ruby 3.1.7
    // (misma version que el interprete compilado, no la 3.3.0 de MinGW que
    // traia el juego) mas los sustitutos de socket.rb e io/wait.rb que el
    // plugin Cable Club exige al arrancar.
    "rubyLoadpath": ["lib"],

    // RPG Maker XP. Game.ini declara RGSS104E.dll; se fija a mano para no
    // depender de que el analisis de Game.ini funcione igual en Horizon.
    "rgssVersion": 1,

    // Un combate de Essentials con el Deluxe Battle Kit encadena bastantes
    // efectos a la vez. 6 se quedaba corto y los sonidos se cortaban.
    "SESourceCount": 12,
    "BGMTrackCount": 1,

    // El juego no lleva NINGUN fichero MIDI: el unico .mid (title_dppt.mid,
    // 2,5 KB) solo aparecia en presets comentados de la pantalla de titulo,
    // cuya configuracion activa usa "bgm:Titulo" -> Titulo.ogg. Por eso no se
    // declara midiSoundFont y soundfont.sf2 (4 MB) no viaja en el paquete.
    // Sin MIDI, fluidsynth deja de ser una dependencia del port.

    "bindingNames": {
      "c": "Aceptar (A)",
      "b": "Cancelar (B)",
      "a": "Accion (Y)",
      "x": "Correr (X)",
      "y": "Menu (ZL)",
      "z": "Especial (ZR)",
      "l": "Anterior (L)",
      "r": "Siguiente (R)"
    },

    "printFPS": false
}
