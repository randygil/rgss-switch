+ *
+ * Asi que se comprueba lo unico que de verdad decide: si mkxp.json esta ahi. */
+static bool nxHayJuegoAqui(const char *donde)
+{
+    if (chdir(donde) != 0)
+        return false;
+    if (access("mkxp.json", R_OK) == 0)
+        return true;
+    Debug() << "[nx]" << donde << "existe pero no tiene mkxp.json; sigo buscando";
+    return false;
+}
