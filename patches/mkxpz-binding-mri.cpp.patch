+#ifdef __SWITCH__
+/* Un gancho para transformar el fuente antes de evaluarlo.
+ *
+ * Cuatro de los siete juegos del censo (Opalo, Iberia, Titan, Z) son mkxp-z
+ * con Ruby 1.8.7, y sus scripts traen entre 25 y 28 lineas que Ruby 3.1 ni
+ * siquiera compila: "when x:" con dos puntos, "retry" fuera de un rescue,
+ * "break" en el cuerpo de un metodo, expresiones regulares con \\xNN. No es
+ * codigo que se porte fichero a fichero -viven dentro de Scripts.rxdata,
+ * comprimidos- ni tiene sentido reescribir los .rxdata en el empaquetador:
+ * eso convertiria cada juego en un ejemplar tocado a mano que nadie podria
+ * comparar con el original.
+ *
+ * Asi que se transforma EN LA CONSOLA, al cargar, y desde Ruby: si existe un
+ * modulo NXFuente que responda a transforma, cada seccion pasa por
+ * NXFuente.transforma(nombre, codigo) y se evalua lo que devuelva. Quien
+ * escribe las reglas es un shim de Ruby (runtime/lib/nx-ruby18.rb), que es
+ * donde se pueden leer, probar y corregir sin recompilar nada.
+ *
+ * Si el modulo no esta -los juegos de Ruby 3.1- esto no cuesta nada: la
+ * comprobacion se hace UNA vez antes del bucle, no una por seccion.
+ *
+ * Y si transforma revienta, se registra y se sigue con el codigo original. Un
+ * fallo en una regla de transformacion no puede ser peor que no transformar:
+ * sin esto, un error de dedo en el shim dejaria al juego sin arrancar y con
+ * una excepcion que apunta a un sitio que el jugador no tiene delante. */
+struct NXFuenteLlamada {
+	VALUE modulo, nombre, codigo;
+};
+
+static VALUE nxFuenteTransforma(VALUE datos)
+{
+	NXFuenteLlamada *l = reinterpret_cast<NXFuenteLlamada *>(datos);
+	return rb_funcall(l->modulo, rb_intern("transforma"), 2, l->nombre, l->codigo);
+}
+
+static VALUE nxFuenteTexto(VALUE excepcion)
+{
+	return rb_obj_as_string(excepcion);
+}
+
+/* Qnil si no hay gancho. Se resuelve una vez, DESPUES de los preload: el
+ * modulo lo define uno de ellos, asi que preguntarlo antes siempre daria que
+ * no. */
+static VALUE nxFuenteModulo(void)
+{
+	ID nombre = rb_intern("NXFuente");
+	VALUE modulo;
+
+	if (!rb_const_defined(rb_cObject, nombre))
+		return Qnil;
+
+	modulo = rb_const_get(rb_cObject, nombre);
+	if (!rb_respond_to(modulo, rb_intern("transforma")))
+		return Qnil;
+
+	nx_boot_trace("[boot] scripts pasan por NXFuente.transforma");
+	return modulo;
+}
+#endif
+
