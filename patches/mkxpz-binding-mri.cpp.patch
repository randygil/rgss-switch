+    nx_donde_init();
+#endif
+
     /* Load global constants */
     rb_gv_set("MKXP", Qtrue);
     
@@ -843,8 +864,22 @@
         return;
     }
     
+    /* Aqui mkxp-z pasaba NULL como estado, es decir, descartaba el resultado
+       de rb_protect: un preload con un error de sintaxis fallaba sin decir
