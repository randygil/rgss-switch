+/* --------------------------------------------------------------------------
+ * El atlas de texto: las cadenas cocidas, muchas por textura.
+ *
+ * El alijo de arriba acierta casi siempre, y cuando acierta dibujar una cadena
+ * cuesta un pegado de 0,04-0,15 ms. Lo que queda caro en la consola es el
+ * FALLO, y los fallos vienen en racimos: abrir una lista nueva es pintar de
+ * golpe cientos de cadenas que nunca se habian visto. El registro de la
+ * consola del 9 de septiembre tiene un fotograma asi:
+ *
+ *   txt 1040x 589 ms | pool 363x 239 ms | nue 349x 229 ms | cad 430/776
+ *
+ * 346 fallos de alijo y 349 Bitmap nuevos: cada cadena cocida era una textura
+ * propia (con su FBO) y el fondo de texturas acerto 2 veces de 363, asi que
+ * casi cada fallo fue una textura creada contra el driver, 0,66 ms de media.
+ * Cuatro de cada diez milisegundos de ese fotograma eran crear texturas para
+ * guardar cadenas de veinte pixeles de alto.
+ *
+ * Aqui las cadenas se guardan en hojas de 512x512, por estantes de la misma
+ * altura (redondeada a 4), con dos pixeles de aire entre una y otra. Un fallo
+ * pasa a ser rasterizar y una subida a un trozo de una hoja que ya existe: una
+ * textura nueva cada cien o doscientas cadenas en vez de una por cadena. Las
+ * hojas son treinta y dos como mucho, los mismos 32 MB de antes; cuando no
+ * cabe nada mas se vacia entera la que hace mas tiempo que no se usa, y sus
+ * cadenas se volveran a cocer si vuelven a pedirse. Hojas de 512 y no de 1024
+ * para que vaciar una tire menos, y porque el emulador cobra algo mas por
+ * pegar desde una textura grande (medido: lo mismo con las dos; ver §5.75).
+ * Una cadena mas ancha que una hoja va al alijo de cajas de antes.
+ *
+ * NI UN PIXEL DISTINTO, y por que. Dibujar sigue siendo el mismo stretchBlt
+ * con el mismo rectangulo de origen, ahora desplazado dentro de la hoja. Sin
+ * estrujar (cadena que cabe en su caja: la inmensa mayoria), cada pixel del
+ * destino lee el centro exacto de un texel del origen, y eso no depende de lo
+ * grande que sea la textura ni de donde este el rectangulo: el mismo texel, el
+ * mismo resultado, por el camino rapido (glBlitFramebuffer) y por el del
+ * sombreador. Estrujando no es asi: las muestras caen entre texels, y a qué
+ * lado de la frontera caen depende del redondeo en coordenadas normalizadas,
+ * que cambia con el tamano de la textura. Para no apostar, una cadena que hay
+ * que estrujar se copia una vez, 1:1, a un Bitmap propio del mismo tamano de
+ * caja que tenia antes (suelta()), y se estruja desde alli: los mismos bytes
+ * en la misma textura que con el alijo de cajas.
+ *
+ * Con sin-atlas.txt en la carpeta del juego se usa el alijo de cajas de
+ * siempre; en modo diagnostico, ademas, la variable RGSS_SIN_ATLAS lo conmuta
+ * en caliente (para comparar los dos caminos en la misma partida).
+ * -------------------------------------------------------------------------- */
+class AlijoTexto
+{
+public:
+    enum { LADO = 512, MAX_HOJAS = 32, AIRE = 2 };
+
+    AlijoTexto() : reloj(0), bytesSueltas(0) {}
+
+    bool busca(const std::string &clave, Cocida **salida)
+    {
+        std::unordered_map<std::string, Entrada>::iterator it = mapa.find(clave);
+        if (it == mapa.end())
+            return false;
+        hojas[it->second.hoja].uso = ++reloj;
+        /* Los elementos de un unordered_map no se mueven al rehacer la tabla:
+         * el puntero vale hasta que se borre la entrada, y eso solo pasa
+         * dentro de guarda(). */
+        *salida = &it->second.c;
+        return true;
+    }
+
+    /* Mete la cadena en una hoja y la sube. NULL si no cabe en ninguna hoja
+     * por tamano (mas ancha que LADO): entonces el que llama va por el camino
+     * de siempre, el alijo de cajas. */
+    Cocida *guarda(const std::string &clave, int ancho, int alto, int altoCrudo,
+                   const void *pixeles)
+    {
+        int h, x, y;
+        if (!reserva(ancho, alto, &h, &x, &y))
+            return NULL;
+
+        Hoja &hoja = hojas[h];
+        TEX::bind(hoja.bmp->getGLTypes().tex);
+        TEX::uploadSubImage(x, y, ancho, alto, pixeles, GL_RGBA);
+
+        Entrada &e = mapa[clave];
+        e.hoja = h;
+        e.c.bmp = hoja.bmp;
+        e.c.x = x;
+        e.c.y = y;
+        e.c.ancho = ancho;
+        e.c.alto = alto;
+        e.c.altoCrudo = altoCrudo;
+        e.c.suelta = NULL;
+        hoja.claves.push_back(clave);
+        hoja.uso = ++reloj;
+        return &e.c;
+    }
+
+    /* La cadena en un Bitmap propio, en (0,0), de la caja redondeada que
+     * usaba el alijo de cajas: lo que hace falta para estrujarla con los
+     * mismos pixeles que antes. Se hace la primera vez que se estruja y se
+     * guarda con la cadena; si las copias ya pasan de 4 MB, no se guarda y el
+     * que llama la suelta (*temporal). */
+    Bitmap *suelta(Cocida &c, bool *temporal)
+    {
+        *temporal = false;
+        if (c.suelta)
+            return c.suelta;
+
+        const int anchoCaja = (c.ancho + 63) & ~63;
+        const int altoCaja = (c.alto + 31) & ~31;
+        Bitmap *b = new Bitmap(anchoCaja, altoCaja);
+        b->stretchBlt(IntRect(0, 0, c.ancho, c.alto), *c.bmp,
+                      IntRect(c.x, c.y, c.ancho, c.alto), 255);
+
+        const size_t peso = (size_t)anchoCaja * altoCaja * 4;
+        if (bytesSueltas + peso > 4u * 1024u * 1024u)
+        {
+            *temporal = true;
+            return b;
+        }
+        bytesSueltas += peso;
+        c.suelta = b;
+        return b;
+    }
+
+    unsigned ocupado() const
+    {
+        return (unsigned)(hojas.size() * (size_t)LADO * LADO * 4 + bytesSueltas);
+    }
+
+private:
+    struct Estante
+    {
+        int y, alto, xLibre;
+    };
+
+    struct Hoja
+    {
+        Bitmap *bmp;
+        std::vector<Estante> estantes;
+        int yLibre;
+        unsigned long long uso;
+        std::vector<std::string> claves;
+    };
+
+    struct Entrada
+    {
+        int hoja;
+        Cocida c;
+    };
+
+    static bool cabeEn(Hoja &hoja, int ancho, int altoE, int *x, int *y)
+    {
+        for (size_t i = 0; i < hoja.estantes.size(); ++i)
+        {
+            Estante &e = hoja.estantes[i];
+            if (e.alto == altoE && e.xLibre + ancho <= LADO)
+            {
+                *x = e.xLibre;
+                *y = e.y;
+                e.xLibre += ancho + AIRE;
+                return true;
+            }
+        }
+        if (hoja.yLibre + altoE > LADO)
+            return false;
+
+        Estante e;
+        e.y = hoja.yLibre;
+        e.alto = altoE;
+        e.xLibre = ancho + AIRE;
+        hoja.estantes.push_back(e);
+        hoja.yLibre += altoE + AIRE;
+        *x = 0;
+        *y = e.y;
+        return true;
+    }
+
+    bool reserva(int ancho, int alto, int *h, int *x, int *y)
+    {
+        const int altoE = (alto + 3) & ~3;
+        if (ancho <= 0 || alto <= 0 || ancho > LADO || altoE > LADO)
+            return false;
+
+        for (size_t i = 0; i < hojas.size(); ++i)
+            if (cabeEn(hojas[i], ancho, altoE, x, y))
+            {
+                *h = (int)i;
+                return true;
+            }
+
+        if (hojas.size() < MAX_HOJAS)
+        {
+            Hoja nueva;
+            nueva.bmp = new Bitmap(LADO, LADO);   /* nace borrada */
+            nueva.yLibre = 0;
+            nueva.uso = ++reloj;
+            hojas.push_back(nueva);
+            *h = (int)hojas.size() - 1;
+            return cabeEn(hojas.back(), ancho, altoE, x, y);
+        }
+
+        /* Todas llenas: se vacia la que hace mas tiempo que no se usa. */
+        size_t vieja = 0;
+        for (size_t i = 1; i < hojas.size(); ++i)
+            if (hojas[i].uso < hojas[vieja].uso)
+                vieja = i;
+        vacia(hojas[vieja]);
+        *h = (int)vieja;
+        return cabeEn(hojas[vieja], ancho, altoE, x, y);
+    }
+
+    void vacia(Hoja &hoja)
+    {
+        for (size_t i = 0; i < hoja.claves.size(); ++i)
+        {
+            std::unordered_map<std::string, Entrada>::iterator it =
+                mapa.find(hoja.claves[i]);
+            if (it == mapa.end())
+                continue;
+            if (it->second.c.suelta)
+            {
+                bytesSueltas -= (size_t)it->second.c.suelta->width() *
+                                it->second.c.suelta->height() * 4;
+                delete it->second.c.suelta;
+            }
+            mapa.erase(it);
+        }
+        hoja.claves.clear();
+        hoja.estantes.clear();
+        hoja.yLibre = 0;
+        /* Lo nuevo se sube encima de lo viejo y solo se lee su rectangulo,
+         * pero el aire entre cadenas tiene que volver a ser cero. */
+        hoja.bmp->clear();
+    }
+
+    std::unordered_map<std::string, Entrada> mapa;
+    std::vector<Hoja> hojas;
+    unsigned long long reloj;
+    size_t bytesSueltas;
+};
+
+AlijoTexto atlasTexto;
+
+/* Como loteActivo() en sprite.cpp: sin-atlas.txt se mira una vez; la variable
+ * de entorno, solo en modo diagnostico y en cada llamada. */
+bool atlasActivo()
+{
+    static int activo = -1;
+    static bool conmutable = false;
+    if (activo < 0)
+    {
+        FILE *f = fopen("sin-atlas.txt", "r");
+        activo = f ? 0 : 1;
+        if (f)
+            fclose(f);
+        conmutable = nx_diagnostico() != 0;
+    }
+    if (conmutable && activo == 1 && getenv("RGSS_SIN_ATLAS"))
+        return false;
+    return activo == 1;
+}
+
