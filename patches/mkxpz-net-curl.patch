+// rgss-switch: la petición corre con el GVL suelto y NADA MÁS.
+//
+// El original armaba el Hash de respuesta (rb_hash_new, rb_str_new...) y
+// lanzaba la excepción (rb_raise) dentro de la función que se le pasa a
+// rb_thread_call_without_gvl, es decir, tocando el intérprete sin tener el
+// candado. Mientras la petición dura otro hilo de Ruby puede estar corriendo,
+// y el recolector con él: es una carrera que no avisa y que, con subidas de
+// varios megas y varios segundos, deja de ser improbable. Aquí la parte sin
+// GVL sólo hace C++ y deja el resultado o el error en una estructura; el Hash
+// y la excepción se hacen al volver, con el candado otra vez en la mano.
+//
+// El error se lanza fuera de la función que tiene los objetos de C++
+// (petición, respuesta, cabeceras) y desde un búfer plano: rb_raise salta con
+// longjmp y no corre destructores, y un plugin que reintenta sin red perdería
+// memoria en cada intento. net.cpp sólo lanza MKXPError, así que la clase es
+// siempre esa.
+
+namespace {
+
+enum HttpVerbo { HTTP_GET, HTTP_POST_FORM, HTTP_POST_BODY };
+
+struct HttpTrabajo {
+    HttpVerbo verbo;
+    mkxp_net::HTTPRequest *req;
+    mkxp_net::StringMap *postData;
+    const char *body;
+    size_t bodyLen;
+    const char *ctype;
+
+    mkxp_net::HTTPResponse *res;
+    char *error;        // búfer del que llama; vacío = sin error
+
+    HttpTrabajo() : verbo(HTTP_GET), req(0), postData(0), body(0), bodyLen(0), ctype(0),
+                    res(0), error(0) {}
+};
+
+const size_t HTTP_ERROR_MAX = 600;
+
+void *httpSinGVL(void *arg) {
+    HttpTrabajo *t = (HttpTrabajo*)arg;
+    try {
+        switch (t->verbo) {
+            case HTTP_GET:
+                t->res = new mkxp_net::HTTPResponse(t->req->get());
+                break;
+            case HTTP_POST_FORM:
+                t->res = new mkxp_net::HTTPResponse(t->req->post(*t->postData));
+                break;
+            case HTTP_POST_BODY:
+                t->res = new mkxp_net::HTTPResponse(t->req->post(t->body, t->bodyLen, t->ctype));
+                break;
+        }
+    } catch (const Exception &e) {
+        snprintf(t->error, HTTP_ERROR_MAX, "%s", e.msg.c_str());
+    } catch (const std::exception &e) {
+        snprintf(t->error, HTTP_ERROR_MAX, "HTTP: %s", e.what());
+    }
+    // Un mensaje vacío no distinguiría el fallo del éxito.
+    if (!t->res && !t->error[0])
+        snprintf(t->error, HTTP_ERROR_MAX, "HTTP: fallo sin mensaje");
+    return 0;
 }
+
+// Corre la petición y devuelve el Hash; si falla, deja el mensaje en `error`
+// y devuelve Qnil. Todos los objetos de C++ mueren antes de salir.
+VALUE httpEjecutar(HttpTrabajo &t, char *error) {
+    error[0] = 0;
+    t.error = error;
+#if RAPI_MAJOR >= 2
+    rb_thread_call_without_gvl(httpSinGVL, &t, 0, 0);
+#else
+    httpSinGVL(&t);
 #endif
+    if (error[0]) {
+        delete t.res;
+        t.res = 0;
+        return Qnil;
+    }
+    VALUE ret = formResponse(*t.res);
+    delete t.res;
+    t.res = 0;
+    return ret;
+}
 
