+/* Que hacer con cada cosa cuando el alijo la echa. Sobrecargas en vez de un
+ * parametro de plantilla: se leen mejor y el compilador elige solo. */
+inline void sueltaGuardado(SDL_Surface *s) { SDL_FreeSurface(s); }
+inline void sueltaGuardado(const Cocida &c) { delete c.bmp; }
+
+template <class T>
+class Alijo
+{
+public:
+    explicit Alijo(size_t tope) : tope(tope), bytes(0) {}
+
+    bool busca(const std::string &clave, T *salida)
+    {
+        typename std::unordered_map<std::string, Nodo>::iterator it =
+            mapa.find(clave);
+        if (it == mapa.end())
+            return false;
+
+        /* Al frente de la cola de uso. splice mueve el nodo sin reasignar, asi
+         * que el iterador que guarda el Nodo sigue valiendo. */
+        usos.splice(usos.begin(), usos, it->second.uso);
+        *salida = it->second.dato;
+        return true;
+    }
+
+    /* Dice si se ha quedado con ello. Si dice que no, el dueno sigue siendo el
+     * que llama y tiene que soltarlo el mismo.
+     *
+     * La primera version se quedaba con la propiedad pasara lo que pasara y
+     * liberaba lo que no le cabia. Era mas corto de escribir y una trampa de
+     * usar: el que dibuja necesita el objeto DESPUES de ofrecerlo, y con aquel
+     * contrato un alijo lleno le dejaba un puntero muerto en la mano. */
+    bool guarda(const std::string &clave, const T &dato, size_t peso)
+    {
+        /* Una sola cosa que se comiera un cuarto del presupuesto echaria fuera
+         * todo lo demas cada vez que apareciera, y el alijo trabajaria en
+         * contra. Esas se quedan sin guardar. */
+        if (peso * 4 > tope || mapa.count(clave))
+            return false;
+
+        while (bytes + peso > tope && !usos.empty())
+            echa();
+
+        usos.push_front(clave);
+
+        Nodo n;
+        n.dato = dato;
+        n.peso = peso;
+        n.uso = usos.begin();
+        mapa[clave] = n;
+        bytes += peso;
+        return true;
+    }
+
+    unsigned ocupado() const { return (unsigned)bytes; }
+
+private:
+    struct Nodo
+    {
+        T dato;
+        size_t peso;
+        std::list<std::string>::iterator uso;
+    };
+
+    void echa()
+    {
+        typename std::unordered_map<std::string, Nodo>::iterator it =
+            mapa.find(usos.back());
+        if (it != mapa.end()) {
+            bytes -= it->second.peso;
+            sueltaGuardado(it->second.dato);
+            mapa.erase(it);
+        }
+        usos.pop_back();
+    }
+
+    std::unordered_map<std::string, Nodo> mapa;
+    std::list<std::string> usos;    /* frente = usado hace menos tiempo */
+    size_t tope;
+    size_t bytes;
+};
+
+/* El monton de la consola son 3.262 MB y el pico medido jugando fue 1.042. El
+ * fondo de texturas se lleva 192 de salida y puede bajar hasta 96 si la GPU
+ * dice que no (§5.64). Estos 224 caben de sobra, y si algun dia no cupieran el
+ * sintoma seria memoria agotada, no lentitud: se veria.
+ *
+ * Ojo con leer estos 224 como memoria de video: no lo son. Lo que guarda el
+ * alijo de imagenes son superficies de SDL, que estan en el monton; lo que
+ * guarda el de texto son Bitmap, y esos SI tienen textura detras y cuentan en
+ * la GPU. De ahi que el segundo sea seis veces mas pequeno que el primero. */
+Alijo<SDL_Surface *> alijoImagen(192u * 1024u * 1024u);
+Alijo<Cocida>        alijoTexto(32u * 1024u * 1024u);
+
+}  /* namespace */
