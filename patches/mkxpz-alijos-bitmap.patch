+/* --------------------------------------------------------------------------
+ * findCenter, del plugin [MUI] Pokemon UI, centra el sprite del Pokemon
+ * buscando su primer pixel opaco desde cada uno de los cuatro bordes. Lo hace
+ * con get_pixel desde Ruby, y medido en la consola sale asi en CADA cambio de
+ * pestana de la vista de datos:
+ *
+ *   Bmp#get_pixel 41.430x / 289 ms / 290.011 objetos
+ *
+ * Cuarenta y un mil llamadas de Ruby a C, cada una con su objeto Color, para
+ * contestar cuatro numeros que se calculan en un barrido de la copia en RAM.
+ * Ese barrido es este. La lectura de la textura (el glReadPixels, contado en
+ * "pix") se hace una vez como en get_pixel; el resto es recorrer memoria.
+ *
+ * Las reglas de barrido reproducen las del plugin, rarezas incluidas: la
+ * busqueda por la izquierda empieza en la columna 1 y la de arriba en la fila
+ * 1, porque el original itera (1..ancho); las de derecha y abajo llegan hasta
+ * el 0. Cambiar eso cambiaria en un pixel donde se pintan los Pokemon, y no
+ * es lo que se esta arreglando.
+ * -------------------------------------------------------------------------- */
+void Bitmap::opaqueBounds(int &left, int &right, int &top, int &bottom) const
+{
+    guardDisposed();
+
+    GUARD_MEGA;
+    GUARD_ANIMATED;
+
+    left = right = top = bottom = -1;
+
+    const int w = width(), h = height();
+    if (w <= 0 || h <= 0)
+        return;
+
+    if (!p->surface)
+    {
+        p->allocSurface();
+        FBO::bind(p->gl.fbo);
+        glState.viewport.pushSet(IntRect(0, 0, w, h));
+        {
+            NX_MIDE(NX_G_LEERPIX);
