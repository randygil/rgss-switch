+/* Una cadena ya rasterizada y subida a la GPU. Lleva sus tres medidas porque
+ * ninguna se deduce de las otras:
+ *
+ *   el Bitmap mide la CAJA, redondeada hacia arriba (ver mas abajo)
+ *   ancho/alto  son los pixeles que de verdad ocupa la cadena dentro
+ *   altoCrudo   es el alto ANTES de sombra y borde, con el que se centra */
+struct Cocida
+{
+    Bitmap *bmp;
