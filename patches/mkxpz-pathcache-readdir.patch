+#ifdef __SWITCH__
+/* Recorrido nativo del arbol, en vez del de PhysFS.
+ *
+ * Medido sobre los 22.318 ficheros del juego, el mismo arbol y en la misma
+ * ejecucion (`nx/nx_fsprobe.c`):
+ *
+ *     PhysFS: PHYSFS_enumerate + PHYSFS_stat por entrada .... 56.065 ms
+ *     opendir/readdir, clasificando por d_type .................. 206 ms
+ *
+ * Doscientas setenta veces. La culpa es del stat —0,85 ms por llamada, que en
+ * Horizon es una IPC al servicio de ficheros— y PhysFS lo hace una vez por
+ * entrada para averiguar algo que readdir ya le habia dicho: la newlib de
+ * devkitPro declara _DIRENT_HAVE_D_TYPE y libnx lo rellena siempre. En las
+ * 22.318 entradas no salio ni un DT_UNKNOWN ni un solo desacuerdo con stat.
+ *
+ * Aqui se construyen las MISMAS dos tablas que cacheEnumCB, con el mismo
+ * criterio de mayusculas y recorriendo las rutas montadas en el mismo orden,
+ * para que nada del resto de mkxp-z note la diferencia.
+ */
+static void nxRecorrer(FileSystemPrivate *p, const std::string &real,
+                       const std::string &rel,
+                       std::vector<std::string> *listaPadre) {
+  DIR *d = opendir(real.c_str());
+  if (!d)
+    return;
+
+  struct dirent *e;
+  while ((e = readdir(d)) != 0) {
+    const char *nombre = e->d_name;
+    if (nombre[0] == '.' &&
+        (nombre[1] == 0 || (nombre[1] == '.' && nombre[2] == 0)))
+      continue;
+
+    std::string hijoReal = real + "/" + nombre;
+    std::string hijoRel = rel.empty() ? std::string(nombre) : rel + "/" + nombre;
+    std::string minusculas = hijoRel;
+    strTolower(minusculas);
+
+    bool esDir;
+    if (e->d_type == DT_DIR) {
+      esDir = true;
+    } else if (e->d_type == DT_UNKNOWN) {
+      /* No ha pasado ni una vez en la consola, pero d_type es opcional por
+       * norma y equivocarse aqui deja ficheros invisibles. */
+      struct stat st;
+      esDir = (stat(hijoReal.c_str(), &st) == 0) && S_ISDIR(st.st_mode);
+    } else {
+      esDir = false;
+    }
+
+    nxEntradas++;
+    if (esDir) {
+      nxDirs++;
+      /* fileLists es un std::map: la referencia sigue siendo valida por muchas
+       * entradas que se inserten despues, que es de lo que depende la
+       * recursion. cacheEnumCB se apoya en lo mismo. */
+      std::vector<std::string> &lista = p->fileLists[minusculas];
+      nxRecorrer(p, hijoReal, hijoRel, &lista);
+    } else {
+      std::string minusculasNombre(nombre);
+      strTolower(minusculasNombre);
+      listaPadre->push_back(minusculasNombre);
+      p->pathCache.insert(minusculas, hijoRel);
+    }
+  }
+
+  closedir(d);
+}
+
+/* ---------------------------------------------------------------------------
+ * El indice de un contenedor, leido por nosotros.
+ *
+ * Medido en la consola, con el juego dentro del contenedor:
+ *
+ *   [cache] PhysFS: 22321 entradas, 171 directorios en 33272 ms
+ *   [cache]   de ellos 342 ms en PHYSFS_stat y 107 ms en el resto
+ *
+ * Treinta y tres segundos, y el desglose senala al culpable sin margen de duda:
+ * el trabajo de verdad son 107 ms y los stat 342, asi que los otros 32,8 s estan
+ * dentro de PHYSFS_enumerate. El archivador de zip de PhysFS guarda sus entradas
+ * en una tabla plana y, para contestar "que hay en este directorio", la recorre
+ * ENTERA. Con 171 directorios y 22.321 entradas eso son 3,8 millones de
+ * comparaciones de cadena. Es cuadratico, y por eso el emulador -x86 y JIT- lo
+ * disimulaba en 5 s mientras un Cortex-A57 a 1 GHz tarda 33.
+ *
+ * El arreglo es el mismo que en §5.48, aplicado al otro lado: en vez de
+ * preguntarle a PhysFS entrada por entrada, se lee el indice de una pasada y se
+ * llenan las tablas nosotros. El indice central de un zip es exactamente eso, una
+ * tabla plana con el nombre, el tamano y el desplazamiento de cada fichero,
+ * pegada al final del archivo; son dos megas que se leen de un tiron.
+ *
+ * Las tablas tienen que quedar IDENTICAS a las que hace cacheEnumCB, o el juego
+ * resolvera rutas distintas segun como se empaqueto:
+ *
+ *   - un directorio crea su lista en fileLists[ruta en minusculas] y no aparece
+ *     en la lista de su padre ni en pathCache;
+ *   - un fichero anade SOLO SU NOMBRE en minusculas a la lista de su directorio,
+ *     y su ruta completa a pathCache (minusculas -> como se escribe de verdad).
+ *
+ * Y quien manda cuando algo esta en dos sitios: PhysFS resuelve por orden de
+ * montaje, asi que el primero que se monta gana. Aqui eso es no pisar una clave
+ * que ya este puesta.
+ */
+
+/* Registro final del zip (EOCD): firma 50 4b 05 06, y a partir de ahi cuantas
+ * entradas hay y donde empieza el indice. Se busca en los ultimos 22 bytes, que
+ * es donde esta si no hay comentario, y si no, en los ultimos 64 KiB, que es lo
+ * maximo que ese comentario puede medir. */
+static bool nxZipEocd(int fd, uint32_t *cdTam, uint32_t *cdOff, unsigned *entradas)
+{
+  unsigned char cola[64 * 1024 + 22];
+  off_t fin = lseek(fd, 0, SEEK_END);
+  off_t desde;
+  ssize_t n;
+  ssize_t i;
+
+  if (fin < 22)
+    return false;
+
+  desde = fin > (off_t)sizeof(cola) ? fin - (off_t)sizeof(cola) : 0;
+  if (lseek(fd, desde, SEEK_SET) != desde)
+    return false;
+  n = read(fd, cola, sizeof(cola));
+  if (n < 22)
+    return false;
+
+  for (i = n - 22; i >= 0; i--) {
+    if (cola[i] != 0x50 || cola[i + 1] != 0x4b || cola[i + 2] != 0x05 ||
+        cola[i + 3] != 0x06)
+      continue;
+
+    *entradas = (unsigned)cola[i + 10] | ((unsigned)cola[i + 11] << 8);
+    *cdTam = (uint32_t)cola[i + 12] | ((uint32_t)cola[i + 13] << 8) |
+             ((uint32_t)cola[i + 14] << 16) | ((uint32_t)cola[i + 15] << 24);
+    *cdOff = (uint32_t)cola[i + 16] | ((uint32_t)cola[i + 17] << 8) |
+             ((uint32_t)cola[i + 18] << 16) | ((uint32_t)cola[i + 19] << 24);
+
+    /* Zip64 marca estos campos con todo unos. No se lee: se devuelve el trabajo
+     * a PhysFS, que si lo entiende. Con 654 MB y 22.000 entradas no aparece. */
+    if (*entradas == 0xFFFF || *cdTam == 0xFFFFFFFFu || *cdOff == 0xFFFFFFFFu)
+      return false;
+    return true;
+  }
+  return false;
+}
+
+/* Un archivo RGSSAD vacio: la cabecera de ocho bytes y nada mas.
+ *
+ * Es la llave que el port pone junto al contenedor para que Essentials use su
+ * camino de archivo (README 5.60). No lleva datos, pero mkxp-z lo monta igual,
+ * y para el camino rapido de aqui un punto de montaje que no sepamos leer vale
+ * lo mismo que rendirse. Este si se sabe: no aporta ninguna entrada. */
+static bool nxRgssadVacio(int fd)
+{
+  char cab[8];
+
+  if (lseek(fd, 0, SEEK_END) != 8)
+    return false;
+  if (lseek(fd, 0, SEEK_SET) != 0 || read(fd, cab, 8) != 8)
+    return false;
+  return memcmp(cab, "RGSSAD", 7) == 0;
+}
+
+/* Solo mira si sabremos leerlo, sin cargar nada. */
+static bool nxZipLegible(const char *ruta)
+{
+  uint32_t cdTam, cdOff;
+  unsigned entradas;
+  int fd = open(ruta, O_RDONLY);
+  bool si;
+
+  if (fd < 0)
+    return false;
+  si = nxZipEocd(fd, &cdTam, &cdOff, &entradas) || nxRgssadVacio(fd);
+  close(fd);
+  return si;
+}
+
+/* Se acuerda del ultimo directorio usado. Las entradas de un zip vienen
+ * agrupadas por carpeta, asi que con esto la busqueda en el mapa pasa de una por
+ * fichero a una por carpeta. */
+struct NxUltimaLista {
+  std::string clave;
+  std::vector<std::string> *lista;
+  NxUltimaLista() : lista(0) {}
+};
+
+/* Crea la lista de un directorio y las de sus padres, si no estaban. */
+static std::vector<std::string> *nxListaDe(FileSystemPrivate *p,
+                                           const std::string &dirMinusculas,
+                                           NxUltimaLista &ultima)
+{
+  if (ultima.lista && ultima.clave == dirMinusculas)
+    return ultima.lista;
+
+  /* Los padres primero: un fichero puede ser lo unico que delate que existe un
+   * directorio, si el zip no trae entradas para las carpetas. */
+  size_t corte = 0;
+  while ((corte = dirMinusculas.find('/', corte)) != std::string::npos) {
+    p->fileLists[dirMinusculas.substr(0, corte)];
+    corte++;
+  }
+
+  std::vector<std::string> &lista = p->fileLists[dirMinusculas];
+  ultima.clave = dirMinusculas;
+  ultima.lista = &lista;
+  return &lista;
+}
+
+static bool nxIndiceZip(FileSystemPrivate *p, const char *ruta)
+{
+  uint32_t cdTam = 0, cdOff = 0;
+  unsigned entradas = 0;
+  unsigned char *cd = 0;
+  NxUltimaLista ultima;
+  int fd = open(ruta, O_RDONLY);
+  bool bien = false;
+
+  if (fd < 0)
+    return false;
+  if (!nxZipEocd(fd, &cdTam, &cdOff, &entradas) || cdTam == 0) {
+    /* Un zip vacio, o la llave RGSSAD de ocho bytes: validos los dos, y ninguno
+     * aporta entradas que indexar. */
+    bool vacio = (entradas == 0 && cdTam == 0) || nxRgssadVacio(fd);
+    close(fd);
+    return vacio;
+  }
+
+  cd = (unsigned char *)malloc(cdTam);
+  if (!cd) {
+    close(fd);
+    return false;
+  }
+  bien = (lseek(fd, cdOff, SEEK_SET) == (off_t)cdOff) &&
+         (read(fd, cd, cdTam) == (ssize_t)cdTam);
+  close(fd);
+  if (!bien) {
+    free(cd);
+    return false;
+  }
+
+  uint32_t pos = 0;
+  while (pos + 46 <= cdTam) {
+    if (cd[pos] != 0x50 || cd[pos + 1] != 0x4b || cd[pos + 2] != 0x01 ||
+        cd[pos + 3] != 0x02)
+      break;
+
+    unsigned nlen = (unsigned)cd[pos + 28] | ((unsigned)cd[pos + 29] << 8);
+    unsigned elen = (unsigned)cd[pos + 30] | ((unsigned)cd[pos + 31] << 8);
+    unsigned clen = (unsigned)cd[pos + 32] | ((unsigned)cd[pos + 33] << 8);
+    uint32_t attrs = (uint32_t)cd[pos + 38] | ((uint32_t)cd[pos + 39] << 8) |
+                     ((uint32_t)cd[pos + 40] << 16) | ((uint32_t)cd[pos + 41] << 24);
+
+    if (pos + 46 + nlen > cdTam)
+      break;
+
+    std::string nombre((const char *)cd + pos + 46, nlen);
+    pos += 46 + nlen + elen + clen;
+
+    /* Un zip escrito en Windows puede traer contrabarras; y una entrada absoluta
+     * o con ".." no es cosa nuestra. */
+    for (size_t k = 0; k < nombre.size(); k++)
+      if (nombre[k] == '\\')
+        nombre[k] = '/';
+    if (nombre.empty() || nombre[0] == '/' || nombre.find("..") != std::string::npos)
+      continue;
+
+    bool esDir = (nombre[nombre.size() - 1] == '/') || (attrs & 0x10);
+    while (!nombre.empty() && nombre[nombre.size() - 1] == '/')
+      nombre.erase(nombre.size() - 1);
+    if (nombre.empty())
+      continue;
+
+    std::string minusculas = nombre;
+    strTolower(minusculas);
+
+    nxEntradas++;
+    if (esDir) {
+      nxDirs++;
+      nxListaDe(p, minusculas, ultima);
+      continue;
+    }
+
+    size_t barra = minusculas.rfind('/');
+    std::string dir = (barra == std::string::npos) ? std::string()
+                                                   : minusculas.substr(0, barra);
+    std::string base = (barra == std::string::npos) ? minusculas
+                                                    : minusculas.substr(barra + 1);
+
+    nxListaDe(p, dir, ultima)->push_back(base);
+
+    /* El primero que se monta manda, igual que en PhysFS: no se pisa lo puesto. */
+    if (!p->pathCache.contains(minusculas))
+      p->pathCache.insert(minusculas, nombre);
+  }
+
+  free(cd);
+  return true;
+}
+
+static bool nxCacheRapido(FileSystemPrivate *p) {
+  char **rutas = PHYSFS_getSearchPath();
+  if (!rutas)
+    return false;
+
+  /* Antes esto se rendia entero en cuanto un punto de montaje no era un
+   * directorio, y con un contenedor eso es siempre: el indice lo acababa
+   * construyendo PhysFS y costaba 33 s (ver arriba). Ahora se mira montaje por
+   * montaje y solo se devuelve el trabajo si aparece algo que no sabemos leer
+   * —un .rgssad de verdad, un 7z—, que es cuando PhysFS sigue siendo el que
+   * sabe. */
+  bool sirve = (*rutas != 0);
+  for (char **r = rutas; *r; r++) {
+    struct stat st;
+    if (stat(*r, &st) == 0 && S_ISDIR(st.st_mode))
+      continue;
+    if (nxZipLegible(*r))
+      continue;
+    Debug() << "[cache] no se leer" << *r << "-> el indice lo construye PhysFS";
+    sirve = false;
+    break;
+  }
+
+  if (sirve) {
+    std::vector<std::string> &raiz = p->fileLists[""];
+    for (char **r = rutas; *r; r++) {
+      struct stat st;
+      if (stat(*r, &st) == 0 && S_ISDIR(st.st_mode))
+        nxRecorrer(p, *r, "", &raiz);
+      else
+        nxIndiceZip(p, *r);
+    }
+  }
+
+  PHYSFS_freeList(rutas);
+  return sirve;
+}
+#endif
