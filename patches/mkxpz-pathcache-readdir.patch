+#ifdef __SWITCH__
+/* Recorrido nativo del arbol, en vez del de PhysFS.
+ *
+ * Medido sobre los 22.318 ficheros del juego, el mismo arbol y en la misma
+ * ejecucion (`nx/nx_fsprobe.c`):
+ *
+ *     PhysFS: PHYSFS_enumerate + PHYSFS_stat por entrada .... 56.065 ms
+ *     opendir/readdir, clasificando por d_type .................. 206 ms
+ *
+ * Doscientas setenta veces. La culpa es del stat —0,85 ms por llamada, que en
+ * Horizon es una IPC al servicio de ficheros— y PhysFS lo hace una vez por
+ * entrada para averiguar algo que readdir ya le habia dicho: la newlib de
+ * devkitPro declara _DIRENT_HAVE_D_TYPE y libnx lo rellena siempre. En las
+ * 22.318 entradas no salio ni un DT_UNKNOWN ni un solo desacuerdo con stat.
+ *
+ * Aqui se construyen las MISMAS dos tablas que cacheEnumCB, con el mismo
+ * criterio de mayusculas y recorriendo las rutas montadas en el mismo orden,
+ * para que nada del resto de mkxp-z note la diferencia.
+ */
+static void nxRecorrer(FileSystemPrivate *p, const std::string &real,
+                       const std::string &rel,
+                       std::vector<std::string> *listaPadre) {
+  DIR *d = opendir(real.c_str());
+  if (!d)
+    return;
+
+  struct dirent *e;
+  while ((e = readdir(d)) != 0) {
+    const char *nombre = e->d_name;
+    if (nombre[0] == '.' &&
+        (nombre[1] == 0 || (nombre[1] == '.' && nombre[2] == 0)))
+      continue;
+
+    std::string hijoReal = real + "/" + nombre;
+    std::string hijoRel = rel.empty() ? std::string(nombre) : rel + "/" + nombre;
+    std::string minusculas = hijoRel;
+    strTolower(minusculas);
+
+    bool esDir;
+    if (e->d_type == DT_DIR) {
+      esDir = true;
+    } else if (e->d_type == DT_UNKNOWN) {
+      /* No ha pasado ni una vez en la consola, pero d_type es opcional por
+       * norma y equivocarse aqui deja ficheros invisibles. */
+      struct stat st;
+      esDir = (stat(hijoReal.c_str(), &st) == 0) && S_ISDIR(st.st_mode);
+    } else {
+      esDir = false;
+    }
+
+    nxEntradas++;
+    if (esDir) {
+      nxDirs++;
+      /* fileLists es un std::map: la referencia sigue siendo valida por muchas
+       * entradas que se inserten despues, que es de lo que depende la
+       * recursion. cacheEnumCB se apoya en lo mismo. */
+      std::vector<std::string> &lista = p->fileLists[minusculas];
+      nxRecorrer(p, hijoReal, hijoRel, &lista);
+    } else {
+      std::string minusculasNombre(nombre);
+      strTolower(minusculasNombre);
+      listaPadre->push_back(minusculasNombre);
+      p->pathCache.insert(minusculas, hijoRel);
+    }
+  }
+
+  closedir(d);
+}
+
+static bool nxCacheRapido(FileSystemPrivate *p) {
+  char **rutas = PHYSFS_getSearchPath();
+  if (!rutas)
+    return false;
+
+  /* Solo sirve si todo lo montado son directorios de verdad: un .rgssad o un
+   * zip no se recorren con readdir, y ahi PhysFS sigue siendo el que sabe. */
+  bool sirve = (*rutas != 0);
+  for (char **r = rutas; *r; r++) {
+    struct stat st;
+    if (stat(*r, &st) != 0 || !S_ISDIR(st.st_mode)) {
+      sirve = false;
+      break;
+    }
+  }
+
+  if (sirve) {
+    std::vector<std::string> &raiz = p->fileLists[""];
+    for (char **r = rutas; *r; r++)
+      nxRecorrer(p, *r, "", &raiz);
+  }
+
+  PHYSFS_freeList(rutas);
+  return sirve;
+}
+#endif
