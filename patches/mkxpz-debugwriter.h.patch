--- src/util/debugwriter.h.orig
+++ src/util/debugwriter.h
@@ -30,6 +30,22 @@
 #include <android/log.h>
 #endif
 
+#ifdef __SWITCH__
+/* Horizon no tiene una salida estandar a la que mirar: std::cerr se pierde.
+   svcOutputDebugString llega al registro Guest de Ryujinx y a las trazas de
+   Atmosphere en consola real, que es la unica forma de diagnosticar esto. */
+#include <switch.h>
+#include <string>
+#include <cstdio>
+/* nx/nx_juego.c. El fichero de registro esta en la carpeta del juego, y esa
+   no se sabe hasta que main() la decide; Debug() se usa desde los
+   constructores estaticos, o sea antes. Lo de antes se guarda en memoria y
+   sale de golpe en cuanto hay donde ponerlo. Aqui no puede resolverse porque
+   esto es una cabecera que incluye medio motor: la logica vive en un solo
+   sitio y esto solo la llama. */
+extern "C" void nx_debug_log(const char *linea);
+#endif
+
 
 /* A cheap replacement for qDebug() */
 
@@ -63,6 +79,16 @@
 	{
 #ifdef __ANDROID__
 		__android_log_write(ANDROID_LOG_DEBUG, "mkxp", buf.str().c_str());
+#elif defined(__SWITCH__)
+		{
+			std::string s = buf.str();
+			svcOutputDebugString(s.c_str(), s.size());
+			/* El registro Guest del emulador no siempre llega hasta el
+			   anfitrion, y en consola real no hay a donde mirar. Se anade a
+			   un fichero de la SD: se abre y cierra en cada linea para que
+			   sobreviva a un cierre brusco. */
+			nx_debug_log(s.c_str());
+		}
 #else
 		std::cerr << buf.str() << std::endl;
 #endif
