+                switch (lang) {
+                case SetLanguage_ES:  tag = "es_ES";  break;
+                case SetLanguage_ES419: tag = "es_419"; break;
+                case SetLanguage_FR: case SetLanguage_FRCA: tag = "fr_FR"; break;
+                case SetLanguage_DE:    tag = "de_DE";  break;
+                case SetLanguage_IT:    tag = "it_IT";  break;
+                case SetLanguage_PT: case SetLanguage_PTBR: tag = "pt_BR"; break;
+                case SetLanguage_JA:    tag = "ja_JP";  break;
+                case SetLanguage_KO:    tag = "ko_KR";  break;
+                case SetLanguage_RU:    tag = "ru_RU";  break;
+                case SetLanguage_ZHCN: case SetLanguage_ZHHANS: tag = "zh_CN"; break;
+                case SetLanguage_ZHTW: case SetLanguage_ZHHANT: tag = "zh_TW"; break;
+                case SetLanguage_NL:    tag = "nl_NL";  break;
+                default:                tag = "en_US";  break;
+                }
+            }
+            setExit();
+        }
+        strncpy(buf, tag, sizeof(buf) - 1);
