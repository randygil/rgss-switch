+#elif defined(__SWITCH__)
+    {
+        u64 lcode = 0;
+        SetLanguage lang = SetLanguage_ENUS;
+        const char *tag = "en_US";
+        if (R_SUCCEEDED(setInitialize())) {
+            if (R_SUCCEEDED(setGetSystemLanguage(&lcode)) &&
