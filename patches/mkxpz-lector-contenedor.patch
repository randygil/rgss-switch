+#ifdef __SWITCH__
+#include <unistd.h>
+
+/* File.open que tambien lee del contenedor.
+ *
+ * El juego no siempre pide sus ficheros por los envoltorios que Essentials trae
+ * para archivos (pbRgssOpen y compania): hay plugins que llaman a File.open a
+ * secas. Con los datos sueltos eso funciona porque estan en la tarjeta; con el
+ * contenedor, Ruby abre por el sistema de ficheros y no ve nada. El sintoma
+ * medido: la pantalla de titulo animada muere con
+ *
+ *   Errno::ENOENT: rb_sysopen - Audio/BGM/TITULO.ogg
+ *   Audio:92:in `open' -> getPlayTime2 -> playBGM
+ *
+ * El apano tiene tres condiciones, y las tres importan para no romper nada:
+ *
+ *   1. Solo si el fichero NO esta de verdad en la tarjeta. Lo que ya funcionaba
+ *      sigue yendo por el camino de siempre, byte a byte.
+ *   2. Solo en modo lectura. Escribir en un contenedor no tiene sentido y las
+ *      partidas guardadas se escriben con File.open("wb"): esas ni se tocan.
+ *   3. Solo si PhysFS lo tiene montado. Si tampoco esta ahi, se deja pasar la
+ *      llamada original para que el error sea exactamente el de siempre.
+ *
+ * Devuelve un FileInt, que es la clase IO respaldada por PhysFS que mkxp-z ya
+ * usa para load_data: lee en flujo, sin cargarse el fichero entero en memoria
+ * para averiguar la duracion de un OGG. */
+static VALUE nxCerrarIO(VALUE io) {
+    return rb_funcall(io, rb_intern("close"), 0);
+}
+
+static VALUE nxYield(VALUE io) {
+    return rb_yield(io);
+}
+
+static bool nxSoloLectura(VALUE modo) {
+    const char *m;
+
+    if (NIL_P(modo))
+        return true;                       /* sin modo, File.open lee */
+    if (!RB_TYPE_P(modo, T_STRING))
+        return false;                      /* entero o hash de opciones: no nos metemos */
+    m = RSTRING_PTR(modo);
+    if (!m || !*m || m[0] != 'r')
+        return false;
+    /* "r", "rb", "r:UTF-8"... pero no "r+", que puede escribir. */
+    for (const char *c = m; *c; c++)
+        if (*c == '+' || *c == 'w' || *c == 'a')
+            return false;
+    return true;
+}
+
+RB_METHOD(nxFileOpen) {
+    RB_UNUSED_PARAM;
+
+    VALUE ruta = Qnil, modo = Qnil, resto = Qnil;
+    rb_scan_args(argc, argv, "11*", &ruta, &modo, &resto);
+
+    if (RB_TYPE_P(ruta, T_STRING) || rb_respond_to(ruta, rb_intern("to_path"))) {
+        VALUE conv = rb_get_path(ruta);
+        const char *p = RSTRING_PTR(conv);
+
+        /* El nombre, tal como esta escrito de verdad. El juego viene de Windows
+           y pide "Audio/BGM/TITULO.ogg" donde el fichero se llama "Titulo.ogg":
+           en FAT32 da igual, dentro de un zip no. desensitize() lo resuelve con
+           el indice de rutas, que es el mismo apano por el que el juego
+           funciona con las carpetas sueltas. */
+        const char *real = (p && *p && shState) ? shState->fileSystem().desensitize(p) : p;
+
+        if (p && *p && access(p, F_OK) != 0 && nxSoloLectura(modo)
+            && shState && real && shState->fileSystem().exists(real)) {
+            VALUE io = fileIntForPath(real, true);
+            if (rb_block_given_p())
+                return rb_ensure(RUBY_METHOD_FUNC(nxYield), io,
+                                 RUBY_METHOD_FUNC(nxCerrarIO), io);
+            return io;
+        }
+    }
+
+    /* Todo lo demas, tal cual estaba: se llama al File.open de Ruby, con su
+       bloque si lo hay. */
+    return rb_funcall_passing_block(rb_cFile, rb_intern("nx_open_original"),
+                                    argc, argv);
+}
+#endif
