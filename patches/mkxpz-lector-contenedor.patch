+#ifdef __SWITCH__
+/* FileInt sabia decir donde estaba, pero no moverse.
+ *
+ * Es una subclase de IO sin descriptor de fichero detras -lo que hay debajo es
+ * un SDL_RWops sobre PhysFS-, asi que todo metodo de IO que no este
+ * reimplementado aqui acaba en el IO de verdad y contesta Errno::EBADF. Se vio
+ * en la consola en cuanto el juego leyo un OGG del contenedor para saber su
+ * duracion:
+ *
+ *   Errno::EBADF: Bad file number
+ *   Audio:93:in `pos='  ->  block in getPlayTime2  ->  playBGM
+ *
+ * Van los cinco que usa quien lee un fichero de datos: colocarse, saltar, volver
+ * al principio, preguntar si se acabo y cuanto mide. Con esto un FileInt se
+ * comporta como el IO que dice ser para todo lo que sea leer. */
+RB_METHOD(fileIntPosNX) {
+    RB_UNUSED_PARAM;
+    SDL_RWops *ops = getPrivateData<SDL_RWops>(self);
+
+    return LL2NUM(SDL_RWtell(ops));
+}
+
+RB_METHOD(fileIntSetPos) {
+    SDL_RWops *ops = getPrivateData<SDL_RWops>(self);
+    VALUE pos;
+
+    rb_scan_args(argc, argv, "1", &pos);
+    SDL_RWseek(ops, NUM2LL(pos), RW_SEEK_SET);
+    return pos;
+}
+
+RB_METHOD(fileIntSeek) {
+    SDL_RWops *ops = getPrivateData<SDL_RWops>(self);
+    VALUE desplazamiento, desde;
+    int origen = RW_SEEK_SET;
+
+    rb_scan_args(argc, argv, "11", &desplazamiento, &desde);
+    if (!NIL_P(desde)) {
+        switch (NUM2INT(desde)) {
+        case 1:  origen = RW_SEEK_CUR; break;   /* IO::SEEK_CUR */
+        case 2:  origen = RW_SEEK_END; break;   /* IO::SEEK_END */
+        default: origen = RW_SEEK_SET; break;
+        }
+    }
+    SDL_RWseek(ops, NUM2LL(desplazamiento), origen);
+    return INT2FIX(0);                          /* IO#seek devuelve 0 */
+}
+
+RB_METHOD(fileIntRewind) {
+    RB_UNUSED_PARAM;
+    SDL_RWops *ops = getPrivateData<SDL_RWops>(self);
+
+    SDL_RWseek(ops, 0, RW_SEEK_SET);
+    return INT2FIX(0);
+}
+
+RB_METHOD(fileIntEof) {
+    RB_UNUSED_PARAM;
+    SDL_RWops *ops = getPrivateData<SDL_RWops>(self);
+    Sint64 donde = SDL_RWtell(ops);
+    Sint64 medida = SDL_RWsize(ops);
+
+    return rb_bool_new(medida >= 0 && donde >= medida);
+}
+
+RB_METHOD(fileIntSize) {
+    RB_UNUSED_PARAM;
+    SDL_RWops *ops = getPrivateData<SDL_RWops>(self);
+
+    return LL2NUM(SDL_RWsize(ops));
+}
 #endif
 
