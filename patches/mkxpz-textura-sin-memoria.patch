+ * Y no puede estar ahi, porque en el momento de la caida el monton iba por
+ * 1.042 MB de 3.166 y quedaban dos gigas sin repartir. Lo que se acabo no fue
+ * el sitio de malloc: fue lo que el driver puede tener mapeado a la vez para la
+ * GPU, y eso no hay forma de preguntarlo desde aqui. Asi que el numero no se
+ * deduce, se mide, y lo unico medido es la banda en la que rompio.
+ *
+ * De ahi sale el techo: 192 MB, una cuarta parte por debajo del borde bajo de
+ * esa banda. No basta con partir 512 por la mitad -que es lo que hace el
+ * guardian de request() al primer choque-, porque 256 cae dentro de la banda.
+ * Y bajar mas de 192 cuesta caro: con 256 MB el fondo se quedaba clavado en su
+ * presupuesto y cada tira de animacion nueva entraba creando contra el driver y
+ * salia borrando, "pool 237x 429 ms" en un solo fotograma. A 192 tampoco es
+ * gratis; es el precio de no volver a pisar el sitio donde el proceso se moria,
+ * y el guardian sigue detras por si tampoco basta.
+ *
+ * Y no es una constante, porque el mismo binario recibe presupuestos muy
+ * distintos segun como se lance: 3,2 GB como aplicacion instalada o como NRO
+ * suplantando un titulo, unos 448 MB como applet de biblioteca (§5.53). Guardar
+ * 192 MB de texturas de un presupuesto de 448 seria absurdo. Asi que se pide un
+ * octavo del monton -el unico techo que si se puede leer, por los simbolos que
+ * __libnx_initheap deja en newlib, los mismos que usa sbrk- y se acota entre 64
+ * y 192 MB. En la consola de verdad manda el techo; en un applet manda el
+ * suelo; y si algun dia el reparto cambia, el fondo se entera solo.
+ *
+ * 192 MB es provisional, y conviene decirlo en voz alta: quien de verdad
+ * estrecha el sitio es el monton de Ruby, que en esa partida subio a 1.042 MB
+ * en diez minutos de juego sin que se sepa todavia por que. Cuando eso se
+ * arregle, este numero podra volver a subir. */
+extern "C" {
+extern char *fake_heap_start;
+extern char *fake_heap_end;
+void nx_boot_trace(const char *msg);
+}
+
+static uint32_t nxPresupuestoFondo(void)
+{
+	const uint32_t suelo = 64u  * 1024 * 1024;
+	const uint32_t techo = 192u * 1024 * 1024;
+
+	uint64_t monton = (uint64_t)(fake_heap_end - fake_heap_start);
+	uint64_t parte  = monton / 8;
+	uint32_t elegido;
+
+	if (parte < suelo)
+		elegido = suelo;
+	else if (parte > techo)
+		elegido = techo;
+	else
+		elegido = (uint32_t)parte;
+
+	/* Que lo diga el registro de arranque, para que el proximo informe de un
+	 * jugador no obligue a adivinar con que presupuesto arranco su consola. */
+	{
+		char linea[176];
+		snprintf(linea, sizeof(linea),
+		         "[fondo] presupuesto inicial %u MB "
+		         "(monton %u MB, un octavo acotado entre %u y %u MB)",
+		         (unsigned)(elegido / (1024 * 1024)),
+		         (unsigned)(monton  / (1024 * 1024)),
+		         (unsigned)(suelo   / (1024 * 1024)),
+		         (unsigned)(techo   / (1024 * 1024)));
+		nx_boot_trace(linea);
+	}
+
+	return elegido;
+}
+#endif
