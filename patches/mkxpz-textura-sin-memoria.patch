+#ifdef __SWITCH__
+/* Devuelve al driver TODAS las texturas guardadas y deja el fondo a cero. No es
+ * lo mismo que disable(): el fondo sigue vivo y volvera a llenarse. */
+static void nxVaciarFondo(TexPoolPrivate *p)
+{
+	for (std::list<TEXFBO>::iterator it = p->priorityQueue.begin();
+	     it != p->priorityQueue.end(); ++it)
+	{
+		TEXFBO obj = *it;
+		TEXFBO::fini(obj);
+	}
+
+	p->priorityQueue.clear();
+	p->poolHash.clear();
+	p->memSize = 0;
+	p->objCount = 0;
+}
+
+/* Vacia la cola de errores de GL. Hasta ahora nadie la miraba, asi que puede
+ * traer cualquier cosa de antes; el tope evita quedarse aqui si el driver se
+ * empena en devolver error. */
+static void nxTiraErrores(void)
+{
+	for (int i = 0; i < 8 && gl.GetError() != GL_NO_ERROR; i++)
+		;
+}
 #endif
 
