+/* ------------------------------------- el recolector y las texturas (§5.76)
+ *
+ * Un jugador perdio dos horas de partida por esto: "No hay memoria de video
+ * para una textura de 512x384", en el snap_to_bitmap del plugin Map Zoom. Ese
+ * plugin, mientras el zoom esta puesto, hace en cada fotograma
+ *
+ *   @sprites["map"].bitmap = Graphics.snap_to_bitmap
+ *
+ * sin disponer el Bitmap de antes. Cada uno son 768 KB de textura que solo se
+ * sueltan cuando el recolector de Ruby recoge el objeto, y el recolector no
+ * sabia nada de esa memoria: para el, un Bitmap son 40 bytes de casilla y un
+ * puntero. En el registro de la consola las texturas vivas pasaban de 650 a
+ * 1.169 MB a 46 MB/s, con el contador de recogidas quieto (668, 670) durante
+ * minutos. Y el monton grande de mkxpz-recolector.patch, que espacia las
+ * pasadas a proposito, lo empeoraba.
+ *
+ * Asi que se le cuenta. Cada textura que el fondo ENTREGA -acierto o nueva-
+ * suma sus bytes al contador de malloc de Ruby con rb_gc_adjust_memory_usage,
+ * y cada una que le DEVUELVEN los resta. Cuando lo entregado y no devuelto
+ * desde la ultima pasada pasa de malloc_limit (16-32 MB), la siguiente
+ * peticion de memoria de Ruby dispara una pasada, igual que si esos bytes
+ * fueran cadenas. Es aqui y no en glTexImage2D por el fondo: una textura que
+ * el fondo guarda ya no la tiene nadie que el recolector pueda soltar, y una
+ * que sale del fondo como acierto si vuelve a estar en manos de un objeto de
+ * Ruby aunque el driver no haya visto nada. Lo que se cuenta es justo lo que
+ * una pasada puede devolver.
+ *
+ * Las dos llamadas van por el enlace (binding-mri.cpp), que es quien sabe si
+ * hay una maquina virtual de Ruby viva: antes de ruby_init o durante el cierre
+ * no hacen nada. */
+extern "C" void nx_rb_memoria_texturas(long bytes);
+extern "C" int  nx_rb_recoge_todo(void);
+
+/* ---------------------------------------------------------------- maqueta
+ *
+ * La red de seguridad de request() solo se ve cuando el driver dice que no, y
+ * en Ryujinx la memoria de video es la del PC: no lo dice nunca. Dos
+ * interruptores para verla igual, como los de NX_FONDO_MAQUETA:
+ *
+ *   NX_TECHO_MAQUETA   un techo de memoria de video, en MB, contado sobre lo
+ *                      entregado y no devuelto. Por encima, nxReservaTextura
+ *                      contesta GL_OUT_OF_MEMORY como lo haria la consola.
+ *   NX_SIN_CUENTA      no le cuenta nada al recolector, para que sea la red de
+ *                      seguridad -y no la cuenta- quien tenga que recoger.
+ *
+ * Los dos a 0 para compilar el motor de verdad. */
+#define NX_TECHO_MAQUETA 0
+#define NX_SIN_CUENTA    0
+
+/* Bytes de textura entregados por el fondo y no devueltos: lo que tienen los
+ * objetos del juego en la mano, que es lo que una pasada del recolector puede
+ * soltar. Solo lo leen el registro y la maqueta. */
+static long long nxEntregados = 0;
+
+static void nxEntrega(long bytes)
+{
+	nxEntregados += bytes;
+#if !NX_SIN_CUENTA
+	nx_rb_memoria_texturas(bytes);
+#endif
+}
+
+extern "C" unsigned nx_texturas_entregadas_mb(void);
+extern "C" unsigned nx_texturas_entregadas_mb(void)
+{
+	return nxEntregados > 0 ? (unsigned)(nxEntregados >> 20) : 0u;
+}
+
+int nxDibujando = 0;
+
+/* La red de seguridad de request() recoge una sola vez por peticion: durante el
+ * reintento esto vale true, y si tampoco cabe se lanza sin volver a recoger. */
+static bool nxReintentando = false;
+
+struct NxReintento
+{
+	NxReintento()  { nxReintentando = true; }
+	~NxReintento() { nxReintentando = false; }
+};
 #endif
 
