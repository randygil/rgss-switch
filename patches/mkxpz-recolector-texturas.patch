+/* --------------------------------------------------------------------------
+ * Lo que el fondo de texturas le cuenta al recolector (texpool.cpp, §5.76).
+ *
+ * TexPool no sabe nada de Ruby y no debe: estas dos son su unica puerta. Las
+ * dos miran antes si hay una maquina virtual a la que hablarle, porque el fondo
+ * existe antes de ruby_init (SharedState se construye primero) y sigue
+ * soltando texturas durante ruby_cleanup, cuando los finalizadores del cierre
+ * liberan los Bitmap que quedaban. rb_gc_adjust_memory_usage sobre una maquina
+ * que no existe es un nulo: rb_objspace sale de GET_VM().
+ * -------------------------------------------------------------------------- */
+extern "C" int ruby_thread_has_gvl_p(void);
+
+static volatile bool nxRubyVivo = false;
+
+/* Bytes de textura que entran (+) o salen (-) de manos de los objetos de Ruby.
+ * Solo toca contadores atomicos del recolector, asi que vale desde cualquier
+ * sitio, tambien desde el dfree de un Bitmap en plena pasada. */
+extern "C" void nx_rb_memoria_texturas(long bytes);
+extern "C" void nx_rb_memoria_texturas(long bytes)
+{
+    if (nxRubyVivo && bytes)
+        rb_gc_adjust_memory_usage((ssize_t)bytes);
+}
+
+static VALUE nxGCStart(VALUE)
+{
+    return rb_funcall(rb_mGC, rb_intern("start"), 0);
+}
+
+/* GC.start: pasada completa, barrido inmediato y finalizadores pendientes. El
+ * GC.start de Ruby y no rb_gc(), que no corre los finalizadores diferidos, y
+ * un Bitmap -su tipo de datos no lleva RUBY_TYPED_FREE_IMMEDIATELY- devuelve la
+ * textura justo ahi. Devuelve 1 si ha pasado. No pasa sin el GVL, ni dentro de
+ * otra pasada, ni sin maquina virtual; y si algo lanza dentro, se traga: quien
+ * llama va a lanzar su propio error de memoria de video. */
+extern "C" int nx_rb_recoge_todo(void);
+extern "C" int nx_rb_recoge_todo(void)
+{
+    if (!nxRubyVivo || rb_during_gc() || !ruby_thread_has_gvl_p())
+        return 0;
+
+    int estado = 0;
+    rb_protect(nxGCStart, Qnil, &estado);
+    if (estado)
+    {
+        rb_set_errinfo(Qnil);
+        return 0;
+    }
+    return 1;
 }
 #endif
 
