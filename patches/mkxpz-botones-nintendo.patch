+	{ SDL_CONTROLLER_BUTTON_Y, Input::A  },   /* X de Switch */
+	{ SDL_CONTROLLER_BUTTON_A, Input::B  },   /* B de Switch: cancelar */
+	{ SDL_CONTROLLER_BUTTON_B, Input::C  },   /* A de Switch: aceptar  */
+	{ SDL_CONTROLLER_BUTTON_X, Input::X  },   /* Y de Switch */
+#else
 	{ SDL_CONTROLLER_BUTTON_X, Input::A  },
 	{ SDL_CONTROLLER_BUTTON_B, Input::B  },
 	{ SDL_CONTROLLER_BUTTON_A, Input::C },
 	{ SDL_CONTROLLER_BUTTON_Y, Input::X  },
+#endif
