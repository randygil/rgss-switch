+/* Arranque de Horizon: donde esta el juego.
+
+   WORKDIR_CURRENT hace que mkxp-z busque mkxp.json, Data/ y Graphics/ en el
+   directorio de trabajo, y hbmenu no garantiza cual es. El orden de busqueda
+   es el de CONVENCIONES 3 y no admite atajos:
+
+     (a) El directorio de argv[0], que es donde esta el .nro que se pulso
+         (p.ej. "sdmc:/switch/<juego>/<juego>.nro").
+     (b) La ruta escrita en romfs:/juego.txt. Es lo que lleva un NSP, porque
+         una aplicacion instalada no tiene argv: el sistema la lanza sin
+         argumentos y (a) no puede contestar nada.
+     (c) Nada. No se adivina.
+
+   Antes habia un paso (c) con dos rutas convenidas escritas aqui dentro. Con
+   un solo juego eso era comodo; con un motor generico es peor que no tener
+   nada, porque un juego mal instalado arrancaria el de al lado sin decirlo.
+   Lo que queda de aquello es la pantalla de aviso, que ahora dice QUE se
+   probo y con que valor en vez de un "no lo encuentro" a secas. */
+/* Un directorio de trabajo vale si tiene el juego dentro.
+ *
+ * chdir() puede salir bien y dejarnos igual de perdidos: la carpeta existe,
+ * pero no es la del juego. Es lo que pasa con el .nro puesto en la raiz de
+ * /switch para que hbmenu lo ensene en la primera pantalla —que es como lo
+ * quiere usar quien juega, sin ir a buscarlo dos carpetas adentro—: el
+ * directorio que sale de argv[0] es /switch, chdir funciona, y mkxp-z se pone a
+ * buscar mkxp.json y Data/ donde no hay nada.
+ *
+ * Asi que se comprueba lo unico que de verdad decide: si mkxp.json esta ahi. */
+static bool nxHayJuegoAqui(const char *donde)
+{
+    if (chdir(donde) != 0)
+        return false;
+    if (access("mkxp.json", R_OK) == 0)
+        return true;
+    Debug() << "[nx]" << donde << "existe pero no tiene mkxp.json; sigo buscando";
+    return false;
+}
+
+static void nxSetupWorkdir(int argc, char *argv[])
+{
+    char apunte[160];
+
+    /* (a) el directorio del .nro */
+    if (argc > 0 && argv[0] && argv[0][0]) {
+        char buf[512];
+        strncpy(buf, argv[0], sizeof(buf) - 1);
+        buf[sizeof(buf) - 1] = 0;
+        char *slash = strrchr(buf, '/');
+        if (slash) {
+            *slash = 0;
+            snprintf(apunte, sizeof(apunte), "argv[0] -> %.130s", buf);
+            nx_intento(apunte);
+            if (nxHayJuegoAqui(buf)) {
+                Debug() << "[nx] directorio de trabajo:" << buf << "(argv[0])";
+                nx_carpeta_juego_fija(buf);
+                return;
+            }
+        } else {
+            nx_intento("argv[0] no lleva ninguna barra: no dice ningun directorio");
+        }
+    } else {
+        nx_intento("argv[0] vacio (lanzado como aplicacion, no como .nro)");
+    }
+
+    /* (b) romfs:/juego.txt
+     *
+     * Un binario solo lleva romfs si alguien se lo puso: elf2nro --romfsdir
+     * para un .nro, hacbrewpack --romfsdir para un NSP. Si no lo lleva,
+     * romfsInit devuelve error y esto es un intento fallido mas, no un fallo.
+     *
+     * PERO PEDIR UN ROMFS QUE NO EXISTE NO ES GRATIS EN EL EMULADOR. Cuando
+     * libnx cree que somos una aplicacion instalada, romfsInit acaba en
+     * fsOpenDataStorageByCurrentProcess; en la consola eso devuelve un error y
+     * aqui no pasaria nada, pero Ryujinx tira una excepcion sin recoger y se
+     * lleva el emulador entero por delante ("The given key '127' was not
+     * present in the dictionary", en VirtualFileSystem.GetRomFs). Y lo cree
+     * siempre: medido el 9 de septiembre de 2026, un .nro suelto lanzado en
+     * Ryujinx contesta envIsNso()=1 -o sea "soy una aplicacion instalada",
+     * que es mentira- con ProgramId 0 y argc 0.
+     *
+     * Por eso el .nro del motor se compila SIEMPRE con --romfsdir aunque su
+     * romfs no lleve ningun juego.txt (ver mkxp-z-nx/Makefile y romfs/): con
+     * un romfs vacio la llamada es segura, el fopen falla como toca y quien
+     * lanzo el binario ve la pantalla de aviso en vez de un emulador cerrado.
+     * El resultado de romfsInit se guarda y se ensena, que es como se llego
+     * hasta aqui. */
+    {
+        Result r = romfsInit();
+        FILE *f = R_SUCCEEDED(r) ? fopen("romfs:/juego.txt", "rb") : NULL;
+        if (!f) {
+            char m[96];
+            snprintf(m, sizeof(m), "romfs:/juego.txt no esta (romfsInit -> 0x%08x)",
+                     (unsigned)r);
+            nx_intento(m);
+        } else {
+            char linea[512] = {0};
+            char *p = linea;
+            if (fgets(linea, sizeof(linea), f)) {
+                /* Una linea, y lo que sobra a los lados no cuenta: el fichero
+                 * lo escribe el empaquetador y puede acabar en CRLF.
+                 *
+                 * El BOM tambien se salta. El acuerdo dice UTF-8 sin BOM, pero
+                 * un juego.txt escrito a mano en el Bloc de notas de Windows
+                 * lo lleva delante, y entonces la ruta empieza por tres bytes
+                 * invisibles y chdir contesta que no existe. Un fallo que no
+                 * se ve en un editor no deberia costar una tarde. */
+                if ((unsigned char)p[0] == 0xEF && (unsigned char)p[1] == 0xBB
+                    && (unsigned char)p[2] == 0xBF)
+                    p += 3;
+                while (*p == ' ' || *p == '\t')
+                    p++;
+                size_t n = strlen(p);
+                while (n && (p[n-1] == '\n' || p[n-1] == '\r'
+                             || p[n-1] == ' ' || p[n-1] == '\t'
+                             || p[n-1] == '/'))
+                    p[--n] = 0;
+            }
+            fclose(f);
+            snprintf(apunte, sizeof(apunte), "romfs:/juego.txt -> %.120s",
+                     *p ? p : "(vacio)");
+            nx_intento(apunte);
+            if (*p && nxHayJuegoAqui(p)) {
+                Debug() << "[nx] directorio de trabajo:" << p << "(romfs:/juego.txt)";
+                nx_carpeta_juego_fija(p);
+                return;
+            }
+        }
+    }
+
+    /* (c) nada. El chdir de nxHayJuegoAqui puede habernos dejado en cualquier
+     * sitio, pero no se fija ninguna carpeta convenida: quien lea el aviso
+     * vera los intentos de arriba, que es lo unico que ayuda. */
+    Debug() << "[nx] NO se pudo fijar el directorio de trabajo";
+    nx_carpeta_juego_rendirse();
+}
+#endif
