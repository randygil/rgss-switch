+/* Arranque de Horizon.
+   WORKDIR_CURRENT hace que mkxp-z busque mkxp.json, Data/ y Graphics/ en el
+   directorio de trabajo. hbmenu no garantiza cual es, asi que lo fijamos al
+   directorio que contiene el propio .nro, tomandolo de argv[0]
+   (p.ej. "sdmc:/switch/pokemon-anil/pokemon-anil.nro"). */
+static void nxSetupWorkdir(int argc, char *argv[])
+{
+    const char *msg;
+    if (argc > 0 && argv[0] && argv[0][0]) {
+        char buf[512];
+        strncpy(buf, argv[0], sizeof(buf) - 1);
+        buf[sizeof(buf) - 1] = 0;
+        char *slash = strrchr(buf, '/');
+        if (slash) {
+            *slash = 0;
+            if (chdir(buf) == 0) {
+                Debug() << "[nx] directorio de trabajo:" << buf;
+                return;
+            }
+            Debug() << "[nx] chdir fallo en" << buf;
+        }
+    }
+    /* ultimo recurso: la ubicacion convenida en la tarjeta SD */
+    if (chdir("sdmc:/switch/pokemon-anil") == 0)
+        Debug() << "[nx] directorio de trabajo: sdmc:/switch/pokemon-anil (reserva)";
+    else
+        Debug() << "[nx] NO se pudo fijar el directorio de trabajo";
+    (void)msg;
+}
+#endif
+
+#ifdef __SWITCH__
+extern "C" void nx_boot_trace(const char *msg);   /* nx/nx_boot.c */
+#endif
