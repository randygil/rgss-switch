 void EventThread::setFullscreen(SDL_Window *win, bool mode)
 {
+#ifdef __SWITCH__
+    /* Siempre a pantalla completa y sin alternativa; ver REQUEST_WINRESIZE.
+     * SDL_SetWindowFullscreen acaba en el mismo switch_create_window_surface. */
+    (void)win;
+    fullscreen = true;
+#else
     SDL_SetWindowFullscreen
     (win, mode ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
     fullscreen = mode;
+#endif
 }
 
