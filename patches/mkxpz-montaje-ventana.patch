+/* Lee entero o hasta el final del fichero. Devolver menos de lo pedido teniendo
+ * mas por delante no es una opcion: PhysFS envuelve casi todas sus lecturas en
+ * __PHYSFS_readAll, que compara con la longitud pedida y da el archivo por
+ * corrupto si no cuadra. */
+static PHYSFS_sint64 nxIoVentanaRead(struct PHYSFS_Io *io, void *destino,
+                                     PHYSFS_uint64 len) {
+  NxIoVentana *v = nxVentana(io);
+  unsigned char *salida = static_cast<unsigned char *>(destino);
+  PHYSFS_uint64 hechos = 0;
+
+  while (hechos < len) {
+    PHYSFS_uint64 falta = len - hechos;
+
+    /* Lo que ya esta delante se copia y no cuesta nada. */
+    if (v->buf && v->pos >= v->base && v->pos < v->base + v->llenos) {
+      PHYSFS_uint64 hay = (PHYSFS_uint64)(v->base + v->llenos - v->pos);
+      PHYSFS_uint64 cuanto = (falta < hay) ? falta : hay;
+
+      memcpy(salida + hechos, v->buf + (v->pos - v->base), (size_t)cuanto);
+      v->pos += (PHYSFS_sint64)cuanto;
+      hechos += cuanto;
+      continue;
+    }
+
+    if (lseek(v->fd, (off_t)v->pos, SEEK_SET) != (off_t)v->pos)
+      break;
+
+    /* Una peticion tan grande como la ventana, o mas, va directa: pasarla por el
+     * trozo solo anadiria una copia y una lectura de relleno. */
+    if (falta >= (PHYSFS_uint64)NX_VENTANA || (!v->buf && !(v->buf = (unsigned char *)malloc(NX_VENTANA)))) {
+      ssize_t n = read(v->fd, salida + hechos, (size_t)falta);
+      if (n <= 0)
+        break;
+      v->pos += (PHYSFS_sint64)n;
+      hechos += (PHYSFS_uint64)n;
+      continue;
+    }
+
+    {
+      ssize_t n = read(v->fd, v->buf, NX_VENTANA);
+      if (n <= 0)
+        break;
+      v->base = v->pos;
+      v->llenos = (PHYSFS_sint64)n;
+    }
+  }
+
+  return (PHYSFS_sint64)hechos;
+}
+
+/* Buscar y decir donde estamos son cuentas, no llamadas al sistema. El lseek de
+ * verdad lo hace la lectura, y solo si no le vale lo que ya tiene delante. */
+static int nxIoVentanaSeek(struct PHYSFS_Io *io, PHYSFS_uint64 offset) {
+  nxVentana(io)->pos = (PHYSFS_sint64)offset;
+  return 1;
+}
+
+static PHYSFS_sint64 nxIoVentanaTell(struct PHYSFS_Io *io) {
+  return nxVentana(io)->pos;
+}
+
+static PHYSFS_sint64 nxIoVentanaLength(struct PHYSFS_Io *io) {
+  return nxVentana(io)->tam;
+}
+
+/* PhysFS duplica el Io por cada fichero que se abre del contenedor, y cada copia
+ * necesita su propio descriptor para poder moverse por su cuenta. La ventana no
+ * se copia: la nueva empieza vacia y, si solo la usan para lecturas grandes, no
+ * llega a reservarse. */
+static struct PHYSFS_Io *nxIoVentanaDuplicate(struct PHYSFS_Io *io) {
+  NxIoVentana *v = nxVentana(io);
+  PHYSFS_Io *copia = nxCrearIoVentana(v->ruta.c_str());
+
+  if (copia)
+    nxVentana(copia)->pos = v->pos;
+
+  return copia;
+}
+
+static void nxIoVentanaDestroy(struct PHYSFS_Io *io) {
+  delete nxVentana(io);
+  delete io;
+}
+
+static PHYSFS_Io nxIoVentanaPlantilla = {0,
+                                         0, /* version, opaque */
+                                         nxIoVentanaRead,
+                                         0, /* write */
+                                         nxIoVentanaSeek,
+                                         nxIoVentanaTell,
+                                         nxIoVentanaLength,
+                                         nxIoVentanaDuplicate,
+                                         0, /* flush */
+                                         nxIoVentanaDestroy};
+
+/* Devuelve 0 para lo que no sea un fichero normal, y eso incluye el ".". Un
+ * directorio lo monta PhysFS con su propio codigo, que no lee por ningun Io. */
+static PHYSFS_Io *nxCrearIoVentana(const char *ruta) {
+  struct stat st;
+  int fd = open(ruta, O_RDONLY);
+
+  if (fd < 0)
+    return 0;
+
+  if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) {
+    close(fd);
+    return 0;
+  }
+
+  NxIoVentana *v = new NxIoVentana(ruta);
+  v->fd = fd;
+  v->tam = (PHYSFS_sint64)st.st_size;
+
+  PHYSFS_Io *io = new PHYSFS_Io;
+  *io = nxIoVentanaPlantilla;
+  io->opaque = v;
+
+  return io;
+}
