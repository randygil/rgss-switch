+enum { NX_VENTANA = 64 * 1024 };
+
+struct NxIoVentana {
+  std::string ruta;
+  int fd;
+  PHYSFS_sint64 pos;    /* donde cree PhysFS que esta el fichero */
+  PHYSFS_sint64 tam;
+  PHYSFS_sint64 base;   /* desplazamiento del primer byte de la ventana */
+  PHYSFS_sint64 llenos; /* bytes validos que hay en ella */
+  unsigned char *buf;
+
+  NxIoVentana(const char *r)
+      : ruta(r), fd(-1), pos(0), tam(0), base(0), llenos(0), buf(0) {}
+
+  ~NxIoVentana() {
+    if (fd >= 0)
+      close(fd);
+    free(buf);
+  }
+};
+
+static PHYSFS_Io *nxCrearIoVentana(const char *ruta);
+
+static inline NxIoVentana *nxVentana(PHYSFS_Io *io) {
+  return static_cast<NxIoVentana *>(io->opaque);
+}
